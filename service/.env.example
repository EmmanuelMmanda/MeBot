# Copy to .env, then set both credentials privately. Never commit .env.
OPENAI_API_KEY=
# Generate a separate service token with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MEBOT_SERVICE_TOKEN=
MEBOT_MODEL=gpt-6-luna
MEBOT_DAILY_REQUEST_LIMIT=48
MEBOT_TIMEOUT_SECONDS=75
MEBOT_CACHE_SECONDS=300
MEBOT_SCHEDULER_ENABLED=false
# Optional operator-approved HTTPS webhook. It receives a count, never article text or context.
MEBOT_WEBHOOK_URL=
MEBOT_WEBHOOK_TOKEN=
