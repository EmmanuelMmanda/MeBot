# Copy to .env, then set both credentials privately. Never commit .env.
OPENAI_API_KEY=
# Generate a separate service token with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MEBOT_SERVICE_TOKEN=
MEBOT_MODEL=gpt-6-luna
# Voice APIs are opt-in and remain unavailable when blank. After an owner-approved
# API project/model and billing choice, set these server-side to supported API models.
# ChatGPT OAuth/plan access does not satisfy these API billing requirements.
MEBOT_REALTIME_MODEL=
MEBOT_REALTIME_VOICE=marin
MEBOT_REALTIME_DAILY_SESSION_LIMIT=2
MEBOT_TRANSCRIPTION_MODEL=
MEBOT_TRANSCRIPTION_DAILY_REQUEST_LIMIT=6
MEBOT_DAILY_REQUEST_LIMIT=48
MEBOT_TIMEOUT_SECONDS=75
MEBOT_CACHE_SECONDS=300
MEBOT_SCHEDULER_ENABLED=false
# Optional operator-approved HTTPS webhook. It receives a count, never article text or context.
MEBOT_WEBHOOK_URL=
MEBOT_WEBHOOK_TOKEN=
